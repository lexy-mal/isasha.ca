# Competition Configuration
# Specify which competition to scrape/use

# Competition identifier (directory name in com_assets/)
COMPETITION_ID=national2026

# Active competition to display (used by com.html)
ACTIVE_COMPETITION=national2026

# For scraping heat lists (participants, heats, and schedule times)
HEAT_LISTS_URL=http://www.comp-mngr.com/national2026/national2026_HeatLists.htm

# NOTE: URLs now live per-competition in com_assets/competitions.json
# (heatListUrl / resultsIndexUrl / resultsDataFile). That is the source of truth,
# so scraping works on a fresh checkout with no .env at all. Everything below is
# an OPTIONAL local override — os.environ beats competitions.json beats .env.
#
# Because these are global, they apply to whichever competition id you scrape.
# Prefer editing competitions.json unless you're deliberately overriding one run.

# For scraping results (leave empty if no results available)
# RESULTS_INDEX_URL=http://www.comp-mngr.com/national2026/national2026_ScoresheetsByPerson.htm
# RESULTS_CGI_URL=http://www.comp-mngr.com/cgi-bin/ScoresheetHandler.pl
# RESULTS_DATA_FILE=<root>/national2026/national2026_scoresheetsbyperson.dat
