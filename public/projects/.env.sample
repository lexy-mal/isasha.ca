# Competition Configuration
# Specify which competition to scrape/use

# Competition identifier (directory name in dance_assets/)
COMPETITION_ID=national2026

# Active competition to display (used by dance.html)
ACTIVE_COMPETITION=national2026

# For scraping entry lists
HEAT_LISTS_URL=http://www.comp-mngr.com/national2026/national2026_EntryLists.htm

# For scraping results (leave empty if no results available)
RESULTS_INDEX_URL=http://www.comp-mngr.com/national2026/national2026_ScoresheetsByPerson.htm
RESULTS_CGI_URL=http://www.comp-mngr.com/cgi-bin/ScoresheetHandler.pl
RESULTS_DATA_FILE=<root>/national2026/national2026_scoresheetsbyperson.dat

# For Imperial Cup archive
# IMPERIAL_CUP_HEAT_LISTS_URL=https://www.comp-mngr.com/impercup2026/ImperCup2026_HeatLists.htm
# IMPERIAL_CUP_RESULTS_INDEX_URL=https://www.comp-mngr.com/impercup2026/ImperCup2026_ScoresheetsByPerson.htm
# IMPERIAL_CUP_DATA_FILE=<root>/impercup2026/impercup2026_scoresheetsbyperson.dat
